---

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<div>
    <p>{title}</p>
    <hr>
</div>

<style>
  div {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  
  hr {
    border: none;
    background: repeating-linear-gradient(90deg,
      #000,
      #000 10px,
      transparent 10px,
      transparent 20px);
    flex: 1;
    height: 5px;
    margin: 0;
  }

  p {
    font-size: 1rem;
    font-weight: 500;
    letter-spacing: 0.08rem;
    margin: 0;
  }
</style>